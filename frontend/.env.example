# ── Outcome frontend (nginx) — container runtime configuration ───────────────
# These are ENV VARS for the frontend container (compose `environment:` / `docker run -e` /
# k8s env). The nginx entrypoint bakes them into /config.js at startup, so ONE built image
# serves ANY domain — no rebuild per environment.

# ── Endpoints: per-service subdomain ingress ─────────────────────────────────
# Leave ALL THREE EMPTY for the default single-origin deploy (Caddy or one nginx fronts
# everything): the SPA derives /api, /ws and /livekit from its own origin — nothing to set.
#
# Set them ONLY when UI / API / WS / LiveKit live on DIFFERENT hosts (e.g. a k8s Ingress).
# The UI itself is served at the root domain (outcome.io); these point at the others:
OUTCOME_API_BASE=          # e.g. https://api.outcome.io/api/v1
OUTCOME_WS_URL=            # e.g. wss://ws.outcome.io/api/v1/ws
OUTCOME_LIVEKIT_URL=       # e.g. wss://livekit.outcome.io
# ⚠ Split subdomains make the UI's requests cross-origin → the API host must send CORS
#   (Access-Control-Allow-Origin: https://outcome.io, allow credentials, + WS Origin check).
#   The native mobile app needs no CORS.

# ── TLS (direct access, no edge proxy) ───────────────────────────────────────
# Comma-separated hosts/IPs the self-signed cert should cover, to get a SECURE CONTEXT on a
# LAN (mic/camera/screen share require https). Reach it at https://<host>:8443 (accept once).
# Behind Caddy / a k8s Ingress leave EMPTY — the edge terminates TLS — and drop the 8443 port.
TLS_SAN=

# ── Backend wiring (compose defaults below are fine; override on k8s) ─────────
BACKEND_UPSTREAM=server:5000   # API service the nginx reverse-proxies /api and /livekit to
DNS_RESOLVER=127.0.0.11        # Docker embedded DNS; on k8s use the kube-dns service ClusterIP

# ── Mobile note (NOT configured here) ────────────────────────────────────────
# The Flutter app takes its endpoints at BUILD time, not from this file:
#   flutter build apk \
#     --dart-define=OUTCOME_API_BASE=https://api.outcome.io/api/v1 \
#     --dart-define=OUTCOME_WS_URL=wss://ws.outcome.io/api/v1/ws \
#     --dart-define=OUTCOME_LIVEKIT_URL=wss://livekit.outcome.io

# ── Outcome production environment ───────────────────────────────────────────
# Copy to `.env` and fill EVERY secret with a fresh value. NEVER commit `.env`.
#
#   cp .env.example .env
#   # then generate secrets:
#   JWT:            openssl rand -hex 32
#   Postgres pass:  openssl rand -hex 24
#   MinIO keys:     openssl rand -hex 12  (access)  /  openssl rand -hex 24 (secret)
#   LiveKit key:    "LK" + openssl rand -hex 6      /  secret: openssl rand -hex 24

# ── Public address ───────────────────────────────────────────────────────────
# The domain users open in the browser. Caddy auto-provisions a Let's Encrypt cert
# for it (and for www.<domain>). Point this domain's DNS A/AAAA record at this host first.
OUTCOME_DOMAIN=chat.example.com
# Optional: a previous domain to keep serving as an alias after a rename, so old links
# and app installs configured with it keep working. Leave equal to OUTCOME_DOMAIN if none.
OUTCOME_LEGACY_DOMAIN=chat.example.com
# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@example.com
# Public IP of THIS host — LiveKit advertises it so browsers can reach voice/video
# media directly (media bypasses the L7 proxy). Must be reachable on 7881/udp range.
LIVEKIT_NODE_IP=203.0.113.10

# ── Images (build & push these, then set the refs) ───────────────────────────
#   docker build -t $REGISTRY/outcome-server:$TAG   ../../ServerDotnet
#   docker build -t $REGISTRY/outcome-frontend:$TAG ../../frontend
SERVER_IMAGE=ghcr.io/CHANGE_ME/outcome-server:latest
FRONTEND_IMAGE=ghcr.io/CHANGE_ME/outcome-frontend:latest

# ── Scale ────────────────────────────────────────────────────────────────────
SERVER_REPLICAS=3

# ── Secrets (REGENERATE — do not ship these values) ──────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres
JWT_KEY=CHANGE_ME_openssl_rand_hex_32
MINIO_ACCESS_KEY=CHANGE_ME_minio_access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
# AES-256-GCM at-rest encryption for uploads: openssl rand -base64 32. Back it up —
# files are unreadable without it.
MINIO_ENC_KEY=CHANGE_ME_openssl_rand_base64_32
LIVEKIT_API_KEY=LKchangeme
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret

# ── App settings ─────────────────────────────────────────────────────────────
SERVER_NAME=Outcome
MINIO_BUCKET=outcome-uploads

# ── Email / SMTP (optional — leave EMAIL_HOST empty to LOG 2FA codes instead) ─
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_USE_SSL=true

# ── SSO (optional) ───────────────────────────────────────────────────────────
# Leave a pair EMPTY to hide that provider's button entirely — the clients ask the server
# which providers it holds keys for and render only those. One client id/secret per
# provider covers BOTH the web and the mobile app (the phone runs the same server-side
# flow in a system browser sheet and gets the token back over the outcome:// scheme).
#
# Google — console.cloud.google.com → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → type "Web application".
#   Authorized redirect URI:  https://<your-domain>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Yandex — oauth.yandex.ru → Create app → "Web services".
#   Redirect URI:  https://<your-domain>/api/v1/auth/oauth/yandex/callback
#   Permissions:   "Access to email address" + "Access to username" (login:email, login:info)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

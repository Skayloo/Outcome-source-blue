# ── Outcome production environment ───────────────────────────────────────────
# Copy to `.env` and fill EVERY secret with a fresh value. NEVER commit `.env`.
#
#   cp .env.example .env
#   # then generate secrets:
#   JWT:            openssl rand -hex 32
#   Postgres pass:  openssl rand -hex 24
#   Garage:         RPC secret openssl rand -hex 32 / key "GK" + openssl rand -hex 12 / secret openssl rand -hex 32
#   LiveKit key:    "LK" + openssl rand -hex 6      /  secret: openssl rand -hex 24

# ── Public address ───────────────────────────────────────────────────────────
# The domain users open in the browser. Caddy auto-provisions a Let's Encrypt cert
# for it (and for www.<domain>). Point this domain's DNS A/AAAA record at this host first.
OUTCOME_DOMAIN=chat.example.com
# Optional: a previous domain to keep serving as an alias after a rename, so old links
# and app installs configured with it keep working. Leave equal to OUTCOME_DOMAIN if none.
OUTCOME_LEGACY_DOMAIN=chat.example.com
# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@example.com
# Public IP of THIS host — LiveKit advertises it so browsers can reach voice/video
# media directly (media bypasses the L7 proxy). Must be reachable on 7881/udp range.
LIVEKIT_NODE_IP=203.0.113.10

# ── Images (build & push these, then set the refs) ───────────────────────────
#   docker build -t $REGISTRY/outcome-server:$TAG   ../../ServerDotnet
#   docker build -t $REGISTRY/outcome-frontend:$TAG ../../frontend
SERVER_IMAGE=ghcr.io/CHANGE_ME/outcome-server:latest
FRONTEND_IMAGE=ghcr.io/CHANGE_ME/outcome-frontend:latest

# ── Scale ────────────────────────────────────────────────────────────────────
SERVER_REPLICAS=3

# ── Secrets (REGENERATE — do not ship these values) ──────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres
JWT_KEY=CHANGE_ME_openssl_rand_hex_32
# File storage: Garage (S3). The key id is GK + 24 hex, the secret 64 hex.
GARAGE_RPC_SECRET=CHANGE_ME_openssl_rand_hex_32
GARAGE_ACCESS_KEY=GKchangeme
GARAGE_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
LIVEKIT_API_KEY=LKchangeme
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret

# ── App settings ─────────────────────────────────────────────────────────────
SERVER_NAME=Outcome
# The storage bucket (the variable keeps its MinIO-days name).
MINIO_BUCKET=outcome-uploads

# ── Push notifications (optional; leave a transport's keys empty to turn it off) ─
# Which gateway issued a device's token decides where its notifications go — the phone tells
# the server, and the server routes on that. Three, because none of them reaches the others'
# devices: APNs for iOS, RuStore for Android phones that have RuStore, FCM for Android phones
# that have Google services.
#
# RuStore Console → your app → Push notifications → Projects. The project id also ships inside
# the Android app (its SDK reads it from the manifest); the service token must not.
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=
#
# Firebase Console → Project settings → Service accounts → Generate new private key. Paste the
# WHOLE json on this one line. It is not google-services.json: that file identifies the app to
# Google and ships in the APK, this one authorises sending to it and must stay on the server.
FCM_CREDENTIALS=


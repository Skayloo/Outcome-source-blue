# Значения для локального стека из docker-compose.yml. Скопируйте в .env и сгенерируйте
# каждую строку — файл в репозитории, а .env в .gitignore, и это единственная причина, по
# которой у двух установок не окажется одного и того же ключа подписи.
#
#   cp .env.example .env
#   # затем по очереди:
#   openssl rand -hex 32      # JWT_KEY
#   openssl rand -hex 16      # POSTGRES_PASSWORD, MINIO_SECRET_KEY, LIVEKIT_API_SECRET

# Подпись сессионных токенов, ссылок на файлы и OAuth-state. HS256 требует минимум 32 байта.
JWT_KEY=CHANGE_ME_openssl_rand_hex_32

POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# Хранилище файлов. MINIO_ACCESS_KEY — это же имя root-пользователя MinIO.
MINIO_ACCESS_KEY=outcome
MINIO_SECRET_KEY=CHANGE_ME_openssl_rand_hex_16

# Голос. Секрет должен быть не короче 32 символов — SDK отвергает короткие.
LIVEKIT_API_KEY=CHANGE_ME_livekit_key
LIVEKIT_API_SECRET=CHANGE_ME_openssl_rand_hex_32

# IP, который LiveKit объявит как медиа-кандидат: в LAN — адрес хоста, на VPS — публичный.
LIVEKIT_NODE_IP=127.0.0.1
